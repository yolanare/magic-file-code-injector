{
  "name": "magic-file-code-injector-builder",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "watch": "sass --watch css/dev:dist --no-source-map",
    "serve": "vite --config config/vite.config.mjs",
    "server": "node config/livereload.js",
    "dev": "concurrently -k -n SASS,SERVER \"npm:watch\" \"npm:server\"",
    "dev:full": "concurrently -k -n SASS,SERVER,VITE \"npm:watch\" \"npm:server\" \"npm:serve\"",
    "build": "sass css/dev:dist --no-source-map"
  },
  "devDependencies": {
    "chokidar": "^4.0.3",
    "concurrently": "^9.2.1",
    "sass": "^1.92.1",
    "vite": "^7.1.3",
    "ws": "^8.18.3"
  }
}
